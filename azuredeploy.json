{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "siteName": {
      "type": "string",
      "defaultValue": "[concat('automotive-chat-', uniqueString(resourceGroup().id))]",
      "metadata": { "description": "Name of the web app that hosts the chat page." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "sku": {
      "type": "string",
      "defaultValue": "F1",
      "allowedValues": [ "F1", "D1", "B1", "S1" ]
    },
    "repoUrl": {
      "type": "string",
      "defaultValue": "https://github.com/Mo7a82/DirectLine-Automotive"
    },
    "branch": {
      "type": "string",
      "defaultValue": "master"
    },
    "directLineSecret": {
      "type": "securestring",
      "metadata": { "description": "Direct Line secret of the bot. Stored as an app setting, never in the repo." }
    },
    "botId": {
      "type": "string",
      "metadata": { "description": "The bot's handle." }
    },
    "botDisplayName": {
      "type": "string",
      "defaultValue": "Automotive Assistant"
    }
  },
  "variables": {
    "planName": "[concat(parameters('siteName'), '-plan')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-03-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "[parameters('sku')]" }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-03-01",
      "name": "[parameters('siteName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "netFrameworkVersion": "v4.0",
          "minTlsVersion": "1.2",
          "appSettings": [
            { "name": "PROJECT", "value": "DirectLineAutomotiveChatBot/DirectLineAutomotiveChatBot.csproj" },
            { "name": "DirectLineSecret", "value": "[parameters('directLineSecret')]" },
            { "name": "BotId", "value": "[parameters('botId')]" },
            { "name": "BotDisplayName", "value": "[parameters('botDisplayName')]" }
          ]
        }
      },
      "resources": [
        {
          "type": "sourcecontrols",
          "apiVersion": "2022-03-01",
          "name": "web",
          "dependsOn": [
            "[resourceId('Microsoft.Web/sites', parameters('siteName'))]"
          ],
          "properties": {
            "repoUrl": "[parameters('repoUrl')]",
            "branch": "[parameters('branch')]",
            "isManualIntegration": true
          }
        }
      ]
    }
  ],
  "outputs": {
    "chatUrl": {
      "type": "string",
      "value": "[concat('https://', reference(parameters('siteName')).defaultHostName, '/')]"
    }
  }
}
