<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to DirectLine.secrets.config in the same folder and fill it in.
  DirectLine.secrets.config is listed in .gitignore, so it never gets committed.

  DirectLineSecret: Azure portal > your bot > Channels > Direct Line > Secret keys.
  BotId: the bot's handle, which is the "from.id" on the bot's messages.
-->
<appSettings>
  <add key="DirectLineSecret" value="YOUR_DIRECT_LINE_SECRET" />
  <add key="BotId" value="YOUR_BOT_HANDLE" />
</appSettings>
